    "voice.background.explanation" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "NEXUS normal macOS süreci ve görünür menü çubuğu öğesiyle son pencere kapalıyken çalışmayı sürdürür. Çıkış yapınca durur; gizli LaunchAgent, girişte başlatma veya ayrı ayrıcalıklı yardımcı kurulmaz." } } } },
