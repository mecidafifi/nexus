    "voice.enable.noRecording" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "NEXUS sürekli bir ses dosyası oluşturmaz; uyandırma öncesi ses kaydetmez veya yüklemez. Mikrofon açıkken menü çubuğu ve durum metni bunu görünür kılar." } } } },
