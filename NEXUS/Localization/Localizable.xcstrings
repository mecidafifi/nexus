    "voice.report.capabilities.spoken" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bugün ve bu hafta özetlerini, açık görevleri, devamsızlık riskini, son tarihleri, finansı, spor ve odak ilerlemesini sorabilir veya bir modülü açabilirsiniz." } } } },
    "voice.report.capabilities.details" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Desteklenen yerel alanlar: bugün, bu hafta, tamamlanmamış görevler, devamsızlık riski, son tarihler, finans özeti, spor/odak ve 1–8 modül gezinmesi. Ekleme veya sınırlı düzenleme/iptal istekleri önce eksiksiz bir taslak olarak gösterilir ve yalnız açık onayla uygulanır." } } } },
