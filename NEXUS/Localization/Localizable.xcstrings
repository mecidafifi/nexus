    "voice.remote.instructions" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Türkçe, kısa ve dürüst yanıt ver. Yalnız kullanıcı sorusunu ve varsa açıkça onaylanmış NEXUS özetini kullan. Bir kayıt değiştirildiğini veya dış eylem yapıldığını iddia etme." } } } },
