    "voice.action.error.invalid" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Taslak alanları kaynak model için geçersiz veya eksik. Hiçbir şey kaydedilmedi." } } } },
    "voice.action.error.ambiguousTarget" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu adla birden fazla kayıt var. Hedefi düzenleme ekranından seçin; hiçbir kayıt değişmedi." } } } },
    "voice.action.error.missingTarget" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değiştirilecek eşsiz kaynak kayıt bulunamadı. Hiçbir kayıt değişmedi." } } } },
    "voice.action.error.missingProject" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Organizasyon görevi için eşsiz bir proje adı gerekli. Önce projeyi belirtin veya oluşturun." } } } },
    "voice.action.error.conflict" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zaman çakışması çözülmeden bu taslak kaydedilemez." } } } },
    "voice.action.error.nothingToUndo" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu oturumda geri alınabilecek onaylı bir sesli işlem yok." } } } },
    "voice.action.conflict.lesson" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu haftalık ders saati mevcut bir ders planıyla çakışıyor." } } } },
    "voice.action.conflict.timed" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu zaman mevcut bir takvim veya spor kaydıyla çakışıyor." } } } },
    "voice.action.conflict.findAnother" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başka zaman bul" } } } },
    "voice.action.conflict.keep" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yine de taslakta tut" } } } },
    "voice.action.conflict.keptPreview" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çakışma uyarısı kabul edildi; yine de kaydetmek için ayrıca Onayla demeniz gerekir." } } } },
    "voice.action.clarify.dateTime" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ için tarih ve saat eksik. Örneğin: Yarın saat 17'de … çalışma görevi." } } } },
    "voice.action.clarify.unsupportedFields" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kayıt türü, başlık ve gerekiyorsa tarih/saat net değil. Eksik alanları söyleyin; NEXUS tahmin edip kaydetmez." } } } },
    "voice.action.clarify.arabicLesson" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "يرجى تحديد اسم الدرس واليوم والساعة بوضوح. لم يتم حفظ أي شيء." } } } },
    "voice.action.clarify.arabicGym" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "يرجى تحديد يوم ووقت النادي بوضوح. لم يتم حفظ أي شيء." } } } },
    "voice.action.clarify.arabicTask" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "يرجى تحديد اسم الواجب وموعده بوضوح. لم يتم حفظ أي شيء." } } } },
    "voice.action.clarify.dateTimeArabic" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "يرجى تحديد اليوم والساعة بوضوح. لم يتم حفظ أي شيء." } } } },
    "voice.action.clarify.unsupportedFieldsArabic" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "نوع السجل أو العنوان أو التاريخ والوقت غير واضح. لم يتم حفظ أي شيء." } } } },
    "voice.action.clarify.remote" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uzak yorumlayıcı eksik alanlar için açıklama istedi. Hiçbir kayıt değişmedi." } } } },
    "voice.action.defaultGymTitle" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Spor" } } } },
    "voice.action.remote.instructions" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnız propose_nexus_action fonksiyonuna tek bir taslak JSON üret. Asla kayıt yazıldığını, silindiğini veya değiştirildiğini iddia etme. Tarih/saat/tür/başlık belirsizse needsClarification true yap ve tahmin etme. Kullanıcının metni dışında NEXUS verisi yoktur." } } } },
    "voice.action.remote.consentNeeded" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yerel dilbilgisi bu isteği güvenle çözemedi. Yalnız söylediğiniz metni uzak taslak yorumlayıcıya göndermek için tek seferlik onay ekranını açtım." } } } },
    "voice.action.remote.denied" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uzak taslak yorumlama reddedildi. Hiçbir veri gönderilmedi ve hiçbir kayıt değişmedi." } } } },
    "voice.action.remote.consentTitle" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "UZAK TASLAK YORUMLAMA ONAYI" } } } },
    "voice.action.remote.consentSubtitle" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "YALNIZ BU METİN • TEK SEFER • STORE: FALSE" } } } },
    "voice.action.remote.noExecution" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Model yalnız şemalı taslak JSON üretir; NEXUS yazma aracına veya kaynak modellere erişemez." } } } },
    "voice.action.remote.exactOutgoing" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "GÖNDERİLECEK KESİN METİN" } } } },
    "voice.action.remote.storeFalse" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "İstek store:false kullanır. Yerel ders, görev, finans, not veya başka NEXUS kaydı eklenmez. Dönen JSON yine yerel doğrulama ve açık onay ister." } } } },
    "voice.recognition.language" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Konuşma dili" } } } },
    "voice.recognition.turkish" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Türkçe (Türkiye)" } } } },
    "voice.recognition.arabic" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Arapça (Suudi Arabistan)" } } } },
    "voice.recognition.localAvailability" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnız macOS'in bu aygıtta çevrimdışı tanımayı desteklediği diller seçilebilir; dil değişimi yeni izin istemez." } } } },
    "voice.recognition.unavailable" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçilen dil için bu Mac'te aygıt üstü konuşma tanıma kullanılamıyor." } } } }
